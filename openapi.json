    "/api/v1/meters/nearby": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Find Meters Near Location",
        "description": "Spatial proximity search returning meters within a given radius (in meters) of (lat, lng).",
        "operationId": "get_nearby_meters_api_v1_meters_nearby_get",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Target latitude (e.g. 26.9124)",
              "title": "Latitude"
            },
            "description": "Target latitude (e.g. 26.9124)"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Target longitude (e.g. 75.7873)",
              "title": "Longitude"
            },
            "description": "Target longitude (e.g. 75.7873)"
          },
          {
            "name": "radius_meters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100000.0,
              "minimum": 10.0,
              "description": "Radius in meters (default 5000m)",
              "default": 5000.0,
              "title": "Radius Meters"
            },
            "description": "Radius in meters (default 5000m)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Maximum number of nearby meters to return",
              "default": 50,
              "title": "Limit"
            },
            "description": "Maximum number of nearby meters to return"
